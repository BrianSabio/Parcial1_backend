extends layout

block content
  h2 Gestión de Turnos

  h3 Asignar nuevo turno
  form#formTurno
    .form-group
      label(for="fecha") Fecha:
      input#fecha(type="date", required=true)
    .form-group
      label(for="hora") Hora:
      input#hora(type="time", required=true)
    .form-group
      label(for="pacienteId") Paciente (ID):
      input#pacienteId(type="text", required=true)
    .form-group
      label(for="profesionalId") Profesional (ID):
      input#profesionalId(type="text", required=true)
    .form-group
      label(for="servicioId") Servicio (ID):
      input#servicioId(type="text", required=true)
    button(type="submit") Guardar Turno

  p.vacio#sinTurnos No hay turnos reservados todavía.

  table.listado#tablaTurnos
    thead
      tr
        th Fecha
        th Hora
        th Paciente
        th Profesional
        th Estado
        th Acciones
    tbody#cuerpoTablaTurnos

  script(src="/js/turnos.js")